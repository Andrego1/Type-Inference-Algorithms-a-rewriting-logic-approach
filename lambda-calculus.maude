fmod LAMBDA-CALCULUS is
    --- modules importados
    protecting NAT .
    protecting STRING .

    ---- sorts
    sorts Var Term .
    subsort Var < Term . 

    subsort String < Var . --- para usar srings como variáveis ex: "x" ou até "yy"

    --- não precisso de usar vars assim, agora
    op x(_) : NzNat -> Var . --- varáveis, ex: x(1), x(2), ... 

    op lambda : Var Term -> Term [format (r! o)] . --- abstração
    op app : Term Term -> Term [format (g! o)] .  --- aplicação

---(
    exemplos ANTIGO:
    (lx.x) = lambda("x", "x") ou lambda(x(1), x(1))
    (lxy.x) = lambda("x", lambda("y", "x")) ou com "x" = x(1) e "y" = x(2)
    (lx.xx)(lx.xx) = app(lambda("x", app("x", "x")), lambda("x", app("x", "x"))) 
    (lx.(ly.y)(lz.z)) = lambda("x", app(lambda("y","y"), lambda("z","z")))
    ((lxy.xyx)(lxy.x))(lxy.y) = app(app(lambda("x",lambda("y", app(app("x", "y"), "x"))), lambda("x", lambda("y", "x"))), lambda("x", lambda("y", "y")))

)   


--------------------------------------------------------------
--- Para ser honesto, não me lembro se era para fazer isto, mas se não for serve como treino

    op sub : Term Var Term -> Term .
    --- funciona como sub(M, X, N) = M[N/X]
    op r _ : Term -> Term .

    vars T1 T2 T3 : Term . 
    var X1 X2 : Var . 

    --- estas eq são para substituição
    --- parece-me que está bem
    --- atenção que estou a assumir que não existe problema com captura de variáveis 
    eq sub(X1, X1, T1) = T1 .
    ceq sub(X1, X2, T1) = X1 if X1 =/= X2 . --- ceq necessario?
    eq sub(app(T1, T2), X1, T3) = app(sub(T1, X1, T3), sub(T2, X1, T3)) .
    ceq sub(lambda(X1, T1), X2, T2) = lambda(X1, T1) if X1 == X2 . --- ceq necessario?
    ceq sub(lambda(X1, T1), X2, T2) = lambda(X1, sub(T1, X2, T2)) if X1 =/= X2 .

    --- estava a tentar fazer redução aqui, faço com rl ou eq?
    --- ainda não está bem

    --- ordem normal: reduzir o b-redex mais à esquerda e mais exterior
    eq r X1 = X1 .
    eq r lambda(X1, T1) = lambda(X1, r T1) . 
    eq r app(lambda(X1, T1), T2) = sub(T1, X1, T2) . 
    eq r app(T1, T2) = if T1 =/= r T1 then r app(r T1, T2) else app(T1, r T2) fi .
    
    --- com o último exemplo ainda não está bem
    --- eu acho que a última regra não combina com um eventual r sub(...) da anterior

    --- outras formas de escrfevre (apenas mudei formato dos constroctures)
    eq sub((app T1 T2), X1, T3) = (app sub(T1, X1, T3) sub(T2, X1, T3)) .
    ceq sub((lambda X1 T1), X2, T2) = (lambda X1 T1) if X1 == X2 . --- ceq necessario?
    ceq sub((lambda X1 T1), X2, T2) = (lambda X1 sub(T1, X2, T2)) if X1 =/= X2 .

    eq r (lambda X1 T1) = lambda X1 r T1 . 
    eq r (app (lambda X1 T1) T2) = sub(T1, X1, T2) . 
    eq r (app T1 T2) = if T1 =/= r T1 then r (app r T1 T2) else (app T1 r T2) fi .

--------------------------------------------------------------

    --- Novas forma de escrever

    --- na verdade acho que não preciso de ter como app2, posso ter app, overloading, tem formato diferente apenas
    op lambda _ _ : Var Term -> Term [format (r! o o o)] . 
    op app _ _ : Term Term -> Term [format (g! o o o)] . 
    --- talvez elemine um e apenas fica uma das maneiras, mas posso fazer como entender
    ---op _ app _ : Term Term -> Term [gather (e E) format (o g! o o)] . 
    --- Tenho de resolver a ambiguidade!
    
---(
    exemplos NOVO:
    (lx.x) = lambda "x" "x"
    (lxy.x) = lambda "x" lambda "y" "x"
    (lx.xx)(lx.xx) = app lambda "x" app "x" "x" lambda "x" app "x" "x"
    (lx.(ly.y)(lz.z)) = lambda "x" app lambda "y" "y" lambda "z" "z"
    ((lxy.xyx)(lxy.x))(lxy.y) = app app lambda "x" lambda "y" app app "x" "y" "x" lambda "x" lambda "y" "x" lambda "x" lambda "y" "y"
)   


--------------------------------------------------------------
    --- types
    --- work in progress

    sorts Type TypeVar . 
    subsorts TypeVar < Type . 
    subsorts String < TypeVar . 

    --- precisa de ser right associative, acho que está bem
    op _ ->' _ : Type Type -> Type [gather (e E) format(o b o o)] .

    --- precisso de ver o unify built-in do maude 

---(
    A unificação que está defenida nos capitulos do livro
    é um comando, ou seja ele não parece ser built-in para modules
    a não ser que seja suposto estar a ver a parte de 
    meta-level, mas não sei se devo estar a ver isso...
    seria muitas mais coisas a ver
)

    sort Context . 
    op nil : -> Context . 
    op _,_:_ : Context Var Type -> Context . 

    ---op _|-_:_ : Context Term Type -> ?? . 

    

endfm