fmod STLC is
    --- modules importados
    protecting NAT .
    protecting STRING .
    protecting BOOL .

    --- Lambda Terms ---

    ---- sorts
    sorts Var Term .
    subsort Var < Term . 

    subsort String < Var . --- para usar srings como variáveis ex: "x" ou até "yy"

    --- não precisso de usar vars assim, agora
    op x(_) : NzNat -> Var . --- varáveis, ex: x(1), x(2), ... 

    op lambda : Var Term -> Term [format (b! o)] . --- abstração
    op app : Term Term -> Term [format (c! o)] .  --- aplicação

    vars T1 T2 T3 : Term . 
    var X1 X2 : Var .

---(
    exemplos:
    (lx.x) = lambda("x", "x") ou lambda(x(1), x(1))
    (lxy.x) = lambda("x", lambda("y", "x")) ou com "x" = x(1) e "y" = x(2)
    (lx.xx)(lx.xx) = app(lambda("x", app("x", "x")), lambda("x", app("x", "x"))) 
    (lx.(ly.y)(lz.z)) = lambda("x", app(lambda("y","y"), lambda("z","z")))
    ((lxy.xyx)(lxy.x))(lxy.y) = app(app(lambda("x",lambda("y", app(app("x", "y"), "x"))), lambda("x", lambda("y", "x"))), lambda("x", lambda("y", "y")))
)   

--------------------------------------------------------------

    --- Novas forma de escrever

    --- nota que existe overloading
    op lambda _ _ : Var Term -> Term [format (b! o o o)] . 
    op app _ _ : Term Term -> Term [format (c! o o o)] . 
    --- talvez elemine um e apenas fica uma das maneiras
    ---op _ app _ : Term Term -> Term [gather (e E) format (o c! o o)] . 
    --- tinha de resolver a ambiguidade! e precedencia!
    
---(
    exemplos:
    (lx.x) = lambda "x" "x"
    (lxy.x) = lambda "x" lambda "y" "x"
    (lx.xx)(lx.xx) = app lambda "x" app "x" "x" lambda "x" app "x" "x"
    (lx.(ly.y)(lz.z)) = lambda "x" app lambda "y" "y" lambda "z" "z"
    ((lxy.xyx)(lxy.x))(lxy.y) = app app lambda "x" lambda "y" app app "x" "y" "x" lambda "x" lambda "y" "x" lambda "x" lambda "y" "y"
)   

--------------------------------------------------------------
    --- Types ---

    sorts Type TypeVar . 
    subsorts TypeVar < Type . 
    subsorts String < TypeVar . 

    op t(_) : NzNat -> TypeVar . --- type, ex: t(1), t(2), ...
    op t(_) : String -> TypeVar . --- type, ex: t("asa"), ,t("as"), ....
    op t(_) : Term -> TypeVar . --- type, ex: t(lambda "x" "x"), ,t(app "x" "y") ....

    --- precisa de ser right associative, acho que está bem
    op _ --> _ : Type Type -> Type [gather (e E) format(o y o o)] .

    sort Env . --- o gamma (ambiente/contexto)
    op nil : -> Env . 

    sort Assign .
    subsort Assign < Env .
   
    op _:_ : Var Type -> Assign [format(o g o o)] . 

    op _ _ : Env Env -> Env [id: nil assoc comm prec 50] .
    ---ceq A1 E1 = E1 
    ---    if occurs(A1,E1) =/= nil .
    ---op occurs : Assign Env -> Env .
    ---eq occurs(A1,nil) = nil .
    ---eq occurs(A1, A1 E1) = A1 .
    ---ceq occurs(A1, A2 E1) = occurs(A1, E1)
    ---    if A1 =/= A2 .
    --- ao usar ele não corre e sai do maude
    --- prec mais baixo = thighter binding (ver manual de maude cap 3.9)
    --- como '_:_' é mais baixo que '_ _' (default é 41), parenthesis não são obrigatórios
    --- podia ser _,_ mas n sei se um char a mais compensava a readability
    

    sort PPair . --- principal pair

    vars TYPE1 TYPE2 TYPE3 TYPE4 : Type .
    vars V1 V2 V3 : TypeVar . 
    var P : PPair .
    vars E1 E2 E3 E4 : Env .
    vars A1 A2 : Assign .
    vars N1 N2 N3 : NzNat .
    sort Pair .
    op pair : PPair NzNat -> Pair .
    op errorp : -> Pair .

    op p : Env Type -> PPair [format (g! o)] .
    op error : -> PPair . --- erro do PPair 

---(
    inference(lambda "x" app "x" "x") ok
    inference(lambda "x" lambda "y" "x") ok
    inference(lambda "x" lambda "y" "y") ok
    inference(lambda "x" "z") ok, seguindo as regras acho que está bem
    inference(lambda "x" app lambda "y" "y" lambda "z" "z") ok
    inference(app lambda "x" lambda "y" app app "x" "y" "x" lambda "x" lambda "y" "x") não dá, acho que está bem (ghci não dá tipo)

    I = lambda "x" "x"
    K = lambda "x" lambda "y" "x"
    S = lambda "x" lambda "y" lambda "z" app app "x" "z" app "y" "z"
)    



    --- inference com numeros

    op inference : Term NzNat -> Pair . 
    eq inference(X1, N1) = pair(p(X1 : t(N1), t(N1)), N1) .
    ceq inference(app T1 T2, N1) = compute1'(inference(T1, N1), T2, intersect(freeVar(T1), freeVar(T2)))
        if inference(T1, N1) =/= errorp .
    eq inference(lambda X1 T1, N1) = computeL(X1, inference(T1,N1)) . 

    op compute1' : Pair Term Term -> Pair . 
    ceq compute1'(pair(p(E1,TYPE1), N1), T2, VARS) = compute1(pair(p(E1,TYPE1), N1), inference(T2, N1 + 1), VARS) 
        if inference(T2, N1 + 1) =/= errorp .
    
    op compute1 : Pair Pair Term -> Pair .
    eq compute1(pair(p(E1,TYPE1), N1),pair(p(E2,TYPE2),N2), VARS) = compute2(unify(computeA(E1,E2,VARS,nil) TYPE1 = TYPE2 --> t(N2 + 1), nil), E1, E2, t(N2 + 1), N2 + 1) .


    op compute2 : SetOfConstraint Env Env Type NzNat -> Pair .
    eq compute2(nil, E1, E2, TYPE1, N1) = pair(p(E1 E2, TYPE1),N1) .
    eq compute2(fail, E1, E2, TYPE1, N1) = errorp . --- unificação falhou
    ceq compute2(S1, E1, E2, TYPE1, N1) = pair(p(applyE'(S1, E1 E2), applyT(S1,TYPE1)),N1)
        if S1 =/= nil /\ S1 =/= fail .


    op computeL : Var Pair -> Pair .
    eq computeL(X1, errorp) = errorp .
    ceq computeL(X1, pair(p(E1,TYPE1),N1)) = pair(p(E1, t(N1 + 1) --> TYPE1), N1 + 2)
        if dom(X1,E1) == nil .
    eq computeL(X1, pair(p(E1,TYPE1),N1)) = pair(p(excludeE(E1,dom(X1,E1)), rg(dom(X1,E1)) --> TYPE1),N1) .


    op applyE' : SetOfConstraint Env -> Env .
    eq applyE'(nil, E1) = E1 . 
    eq applyE'(V1 = TYPE1 S1, E1) = applyE'(S1, (applyE''(V1 = TYPE1, E1, nil))) .

    op applyE'' : Constraint Env Env -> Env .
    eq applyE''(C1, nil, E2) = E2 .
    eq applyE''(V1 = TYPE1, X1 : TYPE2 E1, E2) = applyE''(V1 = TYPE1, E1, X1 : tsub(TYPE2,TYPE1,V1) E2) .

    --- milner's type-inference
    op inference : Term -> PPair . 

    eq inference(X1) = p(X1 : t(X1), t(X1)) .
    ceq inference(app T1 T2) = compute1(inference(T1), inference(T2), intersect(freeVar(T1), freeVar(T2)), t(app T1 T2))
        if inference(T1) =/= error /\ inference(T2) =/= error .
    eq inference(lambda X1 T1) = computeL(X1, inference(T1)) . 

    op computeL : Var PPair -> PPair .
    eq computeL(X1, error) = error .
    ceq computeL(X1, p(E1,TYPE1)) = p(E1, t(X1) --> TYPE1)
        if dom(X1,E1) == nil .
    eq computeL(X1, p(E1,TYPE1)) = p(excludeE(E1,dom(X1,E1)), rg(dom(X1,E1)) --> TYPE1) .
    
    op excludeE : Env Assign -> Env .
    eq excludeE(nil, A1) = nil .
    eq excludeE(A1 E1, A1) = E1 .
    ceq excludeE(A2 E1, A1) = excludeE(E1, A1) 
        if A2 =/= A1 .

    op intersect : Term Term -> Term .
    eq intersect(nil, T1) = nil .
    eq intersect(T1, nil) = nil .
    eq intersect(X1 T1, X1 T2) = X1 intersect(T1, T2) .
    eq intersect(T1, T2) = nil [owise] . --- otherwise

    op rg : Assign -> Type . --- range, ex: rg(x:t1) -> t1
    eq rg(X1 : TYPE1) = TYPE1 .

    op nil : -> Assign . 

    op dom : Var Env -> Assign .
    eq dom(X1, nil) = nil .
    ceq dom(X1, X2 : TYPE1 E1) = dom(X1, E1) 
        if X1 =/= X2 .
    eq  dom(X1, X1 : TYPE1 E1) = X1 : TYPE1 .

    --- unecessary?
    ---sort Vars .
    ---subsort Var < Vars .
    --- para defenir listas de variaveis, posso mudar o sort atual depois!
    op _ _ : Term Term -> Term [comm assoc id: nil prec 50] .
    eq X1 X1 T1 = X1 T1 . --- para ser idempotente (útil para freeVar e não dar erro)
    --- eq X1 T1 X1 = X1 T1 . --- assim variaveis iguais não aparecem, como num conjunto
    var VARS : Term .
    op nil : -> Term . --- estou a usar muitos nil xD

    op freeVar : Term -> Term .
    eq freeVar(nil) = nil .
    eq freeVar(X1) = X1 .
    eq freeVar(app T1 T2) = freeVar(T1) freeVar(T2) .
    eq freeVar(lambda X1 T1) = exclude(freeVar(T1),X1) .

    ---eq idem : Term -> Term .
    ---eq idem(X1 X2 T1) = 

    op exclude : Term Var -> Term .
    --- exclude(v1 v2 v3 v4, v2) -> v1 v3 v4
    eq exclude(nil,X2) = nil .
    eq exclude(X1 VARS, X1) = exclude(VARS, X1) .
    ceq exclude(X1 VARS, X2) = X1 exclude(VARS, X2)
        if X1 =/= X2 .

    op compute1 : PPair PPair Term Type -> PPair .
    eq compute1(p(E1,TYPE1),p(E2,TYPE2), VARS, TYPE3) = compute2(unify(computeA(E1,E2,VARS,nil) TYPE1 = TYPE2 --> TYPE3, nil), E1, E2, TYPE3) .

    op compute2 : SetOfConstraint Env Env Type -> PPair .
    eq compute2(nil, E1, E2, TYPE1) = p(E1 E2, TYPE1) .
    eq compute2(fail, E1, E2, TYPE1) = error . --- caso de unificação falhar
    ceq compute2(S1, E1, E2, TYPE1) = p(applyE(S1, E1 E2, nil), applyT(S1,TYPE1))
        if S1 =/= nil /\ S1 =/= fail .

    --- o meu A é constraint onde tipos das fv(T1 T2) são iguais
    --- (ver o ponto 2 no Milner's type-inference algorithm FLP) 
    --- computeA("x" : "1" --> "2" "y" : "a" "q" : "a" --> "b", "y" : "c" --> "d" "x" : "t1" --> "t2","x" "y", nil)
    op computeA : Env Env Term SetOfConstraint -> SetOfConstraint .
    eq computeA(E1, E2, nil, S1) = S1 .
    ceq computeA(E1, E2, X1 T1, S1) = computeA(E1, E2, T1, rg(dom(X1,E1)) = rg(dom(X1,E2)) S1)
        if dom(X1,E1) =/= nil /\ dom(X1,E2) =/= nil .
    --- não sei se está bem.... mas agora já não dá loop
    ceq computeA(E1, E2, X1 T1, S1) = computeA(E1, E2, T1, S1)
        if dom(X1,E1) == nil . 
    ceq computeA(E1, E2, X1 T1, S1) = computeA(E1, E2, T1, S1)
        if dom(X1,E2) == nil . 
    ---eq computeA(E1 (X1 : TYPE1) E2, E3 (X1 : TYPE2) E4, X1 T1, S2) = computeA(E1 E2, E3 E4, T1, TYPE1 = TYPE2 S2) .

    op applyT : SetOfConstraint Type -> Type .
    eq applyT(nil, TYPE1) = TYPE1 .
    eq applyT(V1 = TYPE1 S1, TYPE2) = applyT(S1, tsub(TYPE2, TYPE1, V1)) .

    op applyE : SetOfConstraint Env Env -> Env .
    eq applyE(S1, nil, E2) = E2 .
    eq applyE(nil, E1, E2) = E1 E2 . 
    eq applyE(V1 = TYPE1 S1, X1 : TYPE2 E1, E2) = applyE(S1, E1, X1 : tsub(TYPE2,TYPE1,V1) E2) .

    op tsub : Type Type TypeVar -> Type .
    --- tsub(o,t,p) -> o[t/p]

    eq tsub(V1, TYPE1, V1) = TYPE1 .
    ceq tsub(V2, TYPE1, V1) = V2
        if V2 =/= V1 .
    eq tsub((TYPE2 --> TYPE3), TYPE1, V1) = tsub(TYPE2, TYPE1, V1) --> tsub(TYPE3, TYPE1, V1) .

---(
    exemplos:
    tsub("t1" --> "t3", "t2" --> "t1", "t3") = "t1" --> "t2" --> "t1"
    tsub("t1" --> "t2" --> "t1", "t3" --> "t4", "t1") = ("t3" --> "t4") --> "t2" --> "t3" --> "t4"
    tsub("t1" --> "t2" --> "t1", "t3" --> "t4", "t2") = "t1" --> ("t3" --> "t4") --> "t1"
)

    sorts Constraint SetOfConstraint .
    subsort Constraint < SetOfConstraint .

    op _=_ : Type Type -> Constraint .
    op nil : -> Constraint . --- poderia fazer nil um sort próprio ....
    op _ _ : SetOfConstraint SetOfConstraint -> SetOfConstraint [assoc id: nil prec 50] .
    --- can not be Constraint Constraint if so more thant two is kind!

    op tsubcons : SetOfConstraint Type TypeVar -> SetOfConstraint .
    --- tsubcons(t1=t2, t, a) -> (t1=t2)[t/a]
    eq tsubcons(nil, TYPE1, V1) = nil .
    eq tsubcons(TYPE1 = TYPE2 S1, TYPE3, V1) = ((tsub(TYPE1, TYPE3, V1) = tsub(TYPE2, TYPE3, V1)) tsubcons(S1, TYPE3, V1)).

    var S1 S2 : SetOfConstraint .
    var C1 : Constraint .

    --- free-variable no sentido de que ocorre em t
    --- defenição formal: fv(x) = {x}, os outros não uso
    op fv : TypeVar Type -> Bool .
    --- fv(x,t) -> if x occurs in t true else false 
    eq fv(V1, V1) = true .
    ceq fv(V1, V2) = false
        if V1 =/= V2 .
    eq fv(V1, TYPE1 --> TYPE2) = fv(V1, TYPE1) or fv(V1, TYPE2) .

    op fail : -> Constraint .

    --- unify types
    --- unify("t1" --> "t2" --> "t3" = "a" --> "b" --> "c",nil) OK
    --- unify("a" = "1" "b" = "2" "c" = "3", nil) OK
    --- in fact, when there is more than 2 constraints it is a kind either in res or given
    --- CORRECTED, SetOfConstraint was only 2 Constraint and not 2 SetOfConstraint
    --- unify("x" = "y" --> "x", nil) OK
    --- unify("x" = "y" --> "y", nil) OK
    --- unify("x" = "b" --> "a" "a" = "c" --> "b" "c" = "e", nil) ok
    --- unify("x" = "b" --> "a" "a" = "c" --> "b" "c" = "e" "b" = "1" --> "2", nil) ok
    op unify : SetOfConstraint SetOfConstraint -> SetOfConstraint .
    eq unify(nil, S2) = S2 .
    eq unify(fail S1, S2) = fail .
    eq unify(TYPE1 = TYPE1 S1, S2) = unify(S1, S2) . 
    eq unify(TYPE1 --> TYPE2 = TYPE3 --> TYPE4 S1, S2) = unify((TYPE1 = TYPE3) (TYPE2 = TYPE4) (S1), S2) .
    eq unify(TYPE1 --> TYPE2 = V1 S1, S2) = unify((V1 = TYPE1 --> TYPE2) (S1), S2) . 
    ceq unify(V1 = TYPE1 S1, S2) = unify(tsubcons(S1, TYPE1, V1), (V1 = TYPE1) tsubcons(S2, TYPE1, V1))
        if fv(V1,TYPE1) == false . --- e x pertence fv(S1)
    ceq unify(V1 = TYPE1 S1, S2) = fail 
        if V1 =/= TYPE1 /\ fv(V1,TYPE1) == true .


endfm