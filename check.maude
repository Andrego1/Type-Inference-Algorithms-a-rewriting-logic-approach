fmod CHECK is

    including ST . --- verificar se este tipo de importação é o mais correto
    including POLY .

    vars TYPE1 TYPE2 TYPE3 TYPE4 : Type .
    vars V1 V2 V3 : TypeVar . 
    vars E1 E2 E3 E4 : Env .
    vars A1 A2 : Assign .
    vars N1 N2 N3 : NzNat .
    vars T1 T2 T3 : Term . 
    var X1 X2 : Var .
    var S1 S2 S3 : SetOfConstraint .
    var C1 : Constraint .

    op lambda _:_ _ : Var Type Term -> Term [format (b! o c! o o o)] .
    --- church style

    op t : -> Term [format (g! o)] . --- true
    op f : -> Term [format (r! o)] . --- false
    op if _ _ _ : Term Term Term -> Term [format (c! o o o o)] . 

    sort TyBool . --- type boolean para t e f
    subsort TyBool < Type .

    op tyb : -> TyBool .

    op error : -> Type . --- caso falhar

    --- type check ? ou type assignment ?
    op check : Env Term -> Type .
    eq check(E1, X1) = checkVar(dom(X1,E1)) . 
    eq check(E1, lambda X1 : TYPE1 T1) = checkLam(TYPE1,check(E1 X1 : TYPE1, T1)) .
    eq check(E1, app T1 T2) = checkApp(check(E1, T1), check(E1, T2)) .
    eq check(E1, let X1 = T1 in T2) = checkLet(check(E1, T1), T2, X1, E1) . --- poly
    eq check(E1, if T1 T2 T3) = checkIf(E1, check(E1, T1), T2, T3) .
    eq check(E1, t) = tyb . --- type bool
    eq check(E1, f) = tyb . --- type bool

    op checkIf : Env Type Term Term -> Type .
    eq checkIf(E1, tyb, T1, T2) = checkIf'(check(E1, T1), check(E1, T2)) .
    eq checkIf(E1, TYPE1, T1, T2) = error [owise] .

    op checkIf' : Type Type -> Type .
    eq checkIf'(TYPE1, TYPE1) = TYPE1 .
    eq checkIf'(TYPE1, TYPE2) = error [owise] .

    op checkLet : Type Term Var Env -> Type . --- poly
    eq checkLet(error, T2, X1, E1) = error .
    eq checkLet(TYPE1, T2, X1, E1) = check(E1 X1 : TYPE1, T2) .

    op checkApp : Type Type -> Type .
    eq checkApp(TYPE1 --> TYPE2, TYPE1) = TYPE2 .
    eq checkApp(TYPE1, TYPE2) = error [owise] .

    op checkLam : Type Type -> Type .
    eq checkLam(TYPE1, error) = error .
    eq checkLam(TYPE1, TYPE2) = TYPE1 --> TYPE2 .

    op checkVar : Assign -> Type .
    eq checkVar(nilA) = error .
    eq checkVar(X1 : TYPE1) = TYPE1 .

    --- isto seria ok, como typecheck ?
    op typeCheck : Env Term Type -> Bool . 
    eq typeCheck(E1, T1, TYPE1) = check(E1, T1) == TYPE1 .



    --- type check?
    --- é basicamente a mesma coisa, não?
    ---op check : Env Term Type -> Bool .
    ---eq check(E1, X1, TYPE1) = rg(dom(X1,E1)) == TYPE1 .
    ---eq check(E1, lambda X1 : TYPE1 T1, TYPE1 --> TYPE3) = check(E1 X1 : TYPE1, T1, TYPE3) .
    ---eq check(E1, app T1 T2, TYPE1) = checkApp(E1, T1, TYPE1, check(E1, T2)) .
    ------ eu tenho de inferir o tipo de pelo menos de um.... no app
    ---eq check(E1, T1, TYPE1) = false [owise] .
---
    ---op checkApp : Env Term Type Type -> Bool .
    ---eq checkApp(E1, T1, TYPE1, error) = false .
    ---eq checkApp(E1, T1, error, TYPE2) = false . --- necessário?
    ---eq checkApp(E1, T1, TYPE1, TYPE2) = check(E1, T1, TYPE2 --> TYPE1) .

endfm